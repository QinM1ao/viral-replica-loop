# Host-only coordinator configuration. Copy this to host.env.
TICKET_ROOT=/absolute/path/to/private-codex-plugin-migration/issues
# TICKET_ID=19
CODEX_MODEL=gpt-5.6-sol
CODEX_EFFORT=high
MAX_REPAIR_ROUNDS=2
MAX_TICKETS=10
INTEGRATION_BRANCH=codex/sandcastle-afk-integration
VERIFY_COMMAND=python3 -m unittest discover -v -s tests -p 'test_*.py'
